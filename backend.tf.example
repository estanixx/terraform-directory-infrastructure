# Optional reference only.
# This repository now keeps backend configuration values out of source and passes
# them through terraform init -backend-config arguments (same pattern as CI).
terraform {
  backend "s3" {
    bucket         = "REPLACE_WITH_TF_STATE_BUCKET"
    key            = "05-tf-directory/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "REPLACE_WITH_LOCK_TABLE"
    encrypt        = true
  }
}
